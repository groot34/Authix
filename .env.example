BACKEND_PORT=8080
BACKEND_ENV=development

# Path to the ordered SQL migrations, relative to the directory the API
# binary is started from. Default (when running via `cd backend && go run
# ./cmd/api`) is ../database/migrations.
MIGRATIONS_DIR=../database/migrations

# Set this to "1" only in local dev environments where PostgreSQL isn't
# running yet and you still want to bring the API up for a quick smoke
# check. Production and normal dev should leave it unset.
AUTHIX_SKIP_DB_STARTUP_CHECK=

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=authix_user
POSTGRES_PASSWORD=authix_password
POSTGRES_DB=authix
